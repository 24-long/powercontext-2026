# Embedded SeekDB directory. Relative paths resolve from the project root.
# In WSL, override this with a native Linux path (for example /tmp/litseek-seekdb), not /mnt/c.
SEEKDB_PATH=backend/data/seekdb
# The embedded engine ships with the persistent "test" database.
SEEKDB_DATABASE=test
# API routes are registered before the optional dist/ static mount.
SERVE_DIST=true
